<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_cavalier_payroll_invoice" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cavalier.payroll.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Payroll Invoicing" string="Payroll Invoicing">
                    <h2>Payroll Invoicing</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="payroll_billing_product_id"/>
                                <div class="text-muted">
                                    Default product used when creating customer invoices from payslips.
                                </div>
                                <field name="payroll_billing_product_id"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="payroll_billing_journal_id"/>
                                <div class="text-muted">
                                    Default sales journal used when creating customer invoices from payslips.
                                </div>
                                <field name="payroll_billing_journal_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
