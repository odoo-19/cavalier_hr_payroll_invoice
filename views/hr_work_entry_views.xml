<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_work_entry_form_inherit_cavalier_customer_location" model="ir.ui.view">
        <field name="name">hr.work.entry.form.inherit.cavalier.customer.location</field>
        <field name="model">hr.work.entry</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <group string="Billing">
                    <field name="customer_id"/>
                    <field name="location_id" domain="customer_id and [('id','child_of', customer_id)] or []"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
